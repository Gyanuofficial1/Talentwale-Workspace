# ============================================================
# TalentWale Backend — AWS Lambda Environment Variables
# ============================================================
# Inhe AWS Lambda Console → Configuration → Environment Variables mein set karein
# KABHI BHI yeh file GitHub pe push mat karo (real values ke saath)
# ============================================================

# ─── App Config ─────────────────────────────────────────────
IS_LAMBDA=true
NODE_ENV=production

# Yeh aapka API Gateway URL hoga (deploy ke baad milega)
# Example: https://abc123.execute-api.ap-south-1.amazonaws.com/prod
PUBLIC_BASE_URL=https://YOUR-API-GATEWAY-URL.execute-api.ap-south-1.amazonaws.com/prod

# ─── WhatsApp (Azure Communication Services) ────────────────
COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://talentwale.india.communication.azure.com/;accesskey=YOUR_KEY
WHATSAPP_CHANNEL_ID=YOUR_CHANNEL_ID
RECIPIENT_PHONE_NUMBER=+919XXXXXXXXX
TW_JOB_SUG_HEADER_IMAGE_URL=https://talentwale.blob.core.windows.net/production/Whatsapp/YOUR_IMAGE.jpeg
BULK_SEND_RATE_PER_SECOND=1

# ─── SMTP / Email Campaign ────────────────────────────────────
SMTP_TEST_RECIPIENT=your-test@email.com
SMTP_SEND_RATE_PER_MINUTE=5
SMTP_BULK_MAX_ROWS=50000

# ─── Email Validation ─────────────────────────────────────────
EMAIL_VERIFY_MODE=mx
EMAIL_VERIFY_ENFORCE=true
EMAIL_VERIFY_TIMEOUT_MS=3000
EMAIL_VERIFY_CACHE_TTL_MS=21600000
EMAIL_BLOCK_DISPOSABLE_DOMAINS=true
EMAIL_BLOCKED_DOMAINS=mailinator.com,guerrillamail.com,10minutemail.com,tempmail.com,yopmail.com,trashmail.com,sharklasers.com
EMAIL_SUPPRESSION_ENABLED=true

# ─── Azure Email Queue ─────────────────────────────────────────
AZURE_STORAGE_QUEUE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=talentwale;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_EMAIL_QUEUE_NAME=email-q
AZURE_EMAIL_QUEUE_POLL_INTERVAL_MS=5000
AZURE_EMAIL_QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
AZURE_EMAIL_QUEUE_BATCH_SIZE=5
AZURE_EMAIL_QUEUE_MAX_DEQUEUE=3
AZURE_EMAIL_QUEUE_SOFT_FAIL_MAX_RETRY=1

# ─── Supabase Database (already configured) ──────────────────
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.YOUR_PROJECT_ID
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
SUPABASE_DB_SSLMODE=require

# ─── Security Tokens (optional but recommended) ───────────────
UNSUBSCRIBE_TOKEN_SECRET=your-secret-token-here-change-this
EMAIL_TRACKING_TOKEN_SECRET=your-tracking-secret-here-change-this

# ─── Startup ──────────────────────────────────────────────────
DB_LOAD_MESSAGE_LIMIT=10
