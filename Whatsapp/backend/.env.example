# Azure Communication Services
AZURE_COMMUNICATION_CONNECTION_STRING=your_connection_string_here
AZURE_STORAGE_ACCOUNT_NAME=your_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_account_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/talentwale

# Server
PORT=3000
NODE_ENV=development

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Bulk Send Configuration
BULK_SEND_RATE_PER_SECOND=3
SMTP_BULK_MAX_ROWS=50000
SMTP_SEND_RATE_PER_MINUTE=120
SMTP_SEND_TIMEOUT_MS=45000

# Email Verification
EMAIL_VERIFY_MODE=mx
EMAIL_VERIFY_ENFORCE=true
EMAIL_BLOCK_DISPOSABLE_DOMAINS=true

# File Upload
MAX_UPLOAD_SIZE_MB=20

# Base URL
PUBLIC_BASE_URL=http://localhost:3000
